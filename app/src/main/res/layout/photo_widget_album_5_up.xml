    <include layout="@layout/photo_widget_content"/>
    <AdapterViewFlipper android:id="@+id/photo_slideshow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:autoStart="true" android:flipInterval="5000" android:inAnimation="@animator/photo_up_in" android:outAnimation="@animator/photo_up_out"/>

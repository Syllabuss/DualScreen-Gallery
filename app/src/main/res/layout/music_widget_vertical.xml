<?xml version='1.0' encoding='utf-8'?>
<FrameLayout android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_surface">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/widget_cover" android:scaleType="fitCenter" android:focusable="true" android:contentDescription="@string/widget_open_cover" android:layout_width="match_parent" android:layout_height="match_parent" />
            <FrameLayout android:id="@+id/widget_effect_disc" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/widget_effect_pulse" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_effect_bars" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/widget_title" style="@style/WidgetTitle" android:maxLines="1" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:focusable="true" android:focusableInTouchMode="true" android:layout_marginTop="8dp">
            <requestFocus />
        </TextView>
        <TextView android:id="@+id/widget_artist" style="@style/WidgetSecondary" android:visibility="gone" />
        <TextView android:id="@+id/widget_status" style="@style/WidgetSecondary" android:visibility="gone" />
        <Chronometer android:id="@+id/widget_elapsed" style="@style/WidgetSecondary" android:visibility="gone" />
        <TextView android:id="@+id/widget_duration" style="@style/WidgetSecondary" android:visibility="gone" />
        <ImageView android:id="@+id/widget_progress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/widget_favorite" style="@style/WidgetButton" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="start">
            <ImageButton android:id="@+id/widget_previous" style="@style/WidgetButton" android:layout_width="match_parent" android:src="@drawable/ph_skip_back" android:contentDescription="@string/widget_previous" android:layout_height="40dp" android:padding="10dp" />
            <ImageButton android:id="@+id/widget_play" style="@style/WidgetButton" android:layout_width="match_parent" android:src="@drawable/ph_play" android:contentDescription="@string/widget_play" android:layout_height="40dp" android:padding="10dp" />
            <ImageButton android:id="@+id/widget_next" style="@style/WidgetButton" android:layout_width="match_parent" android:src="@drawable/ph_skip_forward" android:contentDescription="@string/widget_next" android:layout_height="40dp" android:padding="10dp" />
            <ImageButton android:id="@+id/widget_shuffle" style="@style/WidgetButton" android:layout_width="match_parent" android:src="@drawable/ph_shuffle" android:contentDescription="@string/text_shuffle_169374" android:visibility="gone" android:layout_height="40dp" android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

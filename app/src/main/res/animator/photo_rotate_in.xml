<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="450" android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder android:propertyName="rotationY" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="-90"/>
        <keyframe android:fraction="0.5" android:value="-90"/>
        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </propertyValuesHolder>
</objectAnimator>
